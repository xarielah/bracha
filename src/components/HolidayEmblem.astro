---
import { Image } from 'astro:assets';
import { getHolidayArt } from '../data/holidayArt';

export interface Props {
  slug: string;
  class?: string;
  alt?: string;
  widths?: number[];
  sizes?: string;
}
const {
  slug,
  class: className = '',
  alt = '',
  widths = [82, 164, 328],
  sizes = '82px',
} = Astro.props;
const art = getHolidayArt(slug);
---

{
  art ? (
    <Image
      src={art.emblem}
      alt={alt}
      class:list={['holiday-emblem', className]}
      widths={widths}
      sizes={sizes}
    />
  ) : null
}

<style>
  .holiday-emblem {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    aspect-ratio: 1 / 1;
  }
</style>
