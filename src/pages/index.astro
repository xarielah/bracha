---
import BaseLayout from '../layouts/BaseLayout.astro';
import HolidayCard from '../components/HolidayCard.astro';
import AdUnit from '../components/AdUnit.astro';
import { holidays } from '../data/holidays';
import { AD_SLOTS } from '../lib/ads';

const site = Astro.site ?? new URL('https://bracha.labkit.dev');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'ברכות לחגי ישראל',
    url: site.href,
    inLanguage: 'he-IL',
    description:
      'יצירת ברכות אישיות, אינטראקטיביות ומעוצבות לכל חגי ישראל, ושיתוף שלהן בקישור אחד.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'חגי ישראל',
    itemListElement: holidays.map((h, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `ברכות ל${h.name}`,
      url: new URL(`/${h.slug}`, site).href,
    })),
  },
];
---

<BaseLayout
  title="ברכות לחגי ישראל | ברכה אישית ואינטראקטיבית לשיתוף בקישור"
  description="צרו ברכות לחגי ישראל בחינם: ראש השנה, חנוכה, פורים, פסח, שבועות ועוד. ברכה אישית מעוצבת ואינטראקטיבית – שיתוף בקישור אחד בוואטסאפ."
  path="/"
  keywords={['ברכות לחגים', 'ברכות לחגי ישראל', 'ברכה לראש השנה', 'ברכה לחנוכה', 'ברכה לפורים', 'ברכה לפסח', 'כרטיס ברכה דיגיטלי', 'ברכה אישית', 'ברכה אינטראקטיבית', 'ברכה בוואטסאפ']}
  jsonLd={jsonLd}
>
  <header class="hero">
    <div class="container">
      <p class="hero-kicker">ברכות דיגיטליות · שיתוף בקישור אחד</p>
      <h1>ברכות לחגי ישראל</h1>
      <p class="hero-lead">
        שלחו ברכה שגורמת לחיוך: בוחרים חג, מזינים את שם המברך/ת ואת שם המבורך/ת,
        מוסיפים מלל אישי – ומקבלים ברכה מעוצבת ואינטראקטיבית לפי הסממנים של החג.
        משתפים בוואטסאפ בקישור אחד, וכל מי שפותח זוכה להפתעה קטנה.
      </p>
    </div>
  </header>

  <main class="container">
    <h2 class="grid-title">בחרו חג</h2>
    <ul class="holiday-grid" role="list">
      {
        holidays.map((h) => (
          <li>
            <HolidayCard holiday={h} />
          </li>
        ))
      }
    </ul>

    <AdUnit slot={AD_SLOTS.content} />

    <section class="how">
      <h2>איך זה עובד?</h2>
      <ol>
        <li><strong>בוחרים חג</strong> מתוך לוח החגים למעלה.</li>
        <li><strong>ממלאים שמות ומלל</strong> – ורואים את הברכה מתעדכנת בזמן אמת.</li>
        <li><strong>יוצרים קישור</strong> ומשתפים בוואטסאפ, במייל או ברשתות.</li>
        <li>הנמען פותח, לוחץ <em>"לחצו כדי לחשוף את הברכה"</em> – ומקבל ברכה חגיגית.</li>
      </ol>
    </section>

    <section class="why-bracha" aria-labelledby="why-title">
      <h2 id="why-title">למה ברכה דיגיטלית לחג?</h2>
      <p>
        במקום כרטיס גנרי, כאן בונים ברכה אישית לכל חג ישראלי — עם עיצוב לפי
        הסממנים של החג, שמות שלכם ושל המקבל/ת, ומלל קצר משלכם. הקישור עובד בכל
        מכשיר, בלי אפליקציה ובלי הרשמה, ומתאים לשליחה בוואטסאפ למשפחה ולחברים.
      </p>
      <p>
        בחרו חג מהרשימה למעלה: ראש השנה, יום כיפור, סוכות, שמחת תורה, חנוכה,
        ט״ו בשבט, פורים, פסח, יום העצמאות, ל״ג בעומר או שבועות — והברכה מוכנה
        לשיתוף תוך דקות.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    padding: clamp(3rem, 9vw, 6rem) 0 clamp(2rem, 5vw, 3rem);
    background: radial-gradient(1200px 500px at 80% -10%, var(--hero-glow-2), transparent),
      radial-gradient(900px 500px at 0% 0%, var(--hero-glow-1), transparent);
  }

  .hero-kicker {
    margin: 0 0 0.5rem;
    letter-spacing: 0.14em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--brand);
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(2.2rem, 7vw, 4rem);
  }

  .hero-lead {
    margin: 1rem 0 0;
    max-width: 60ch;
    font-size: clamp(1rem, 2.6vw, 1.25rem);
    color: var(--text-muted);
  }

  .grid-title {
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 1rem;
    font-size: 1.4rem;
  }

  .holiday-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(0.8rem, 2vw, 1.4rem);
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }

  .how {
    margin: clamp(3rem, 8vw, 5rem) 0;
    max-width: 65ch;
  }

  .how ol {
    padding-inline-start: 1.2rem;
    line-height: 1.9;
  }

  .why-bracha {
    margin: clamp(2.5rem, 7vw, 4rem) 0 clamp(3rem, 8vw, 5rem);
    max-width: 65ch;
  }
  .why-bracha h2 {
    font-size: 1.4rem;
    margin: 0 0 0.75rem;
  }
  .why-bracha p {
    color: var(--text-muted);
    margin: 0 0 0.9rem;
  }
</style>
