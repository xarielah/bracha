# MongoDB connection string (MongoDB Atlas or self-hosted)
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority"

# Optional: database name (defaults to "bracha")
MONGODB_DB="bracha"

# Public site URL used for canonical tags, OG and share links.
# Production (Vercel) MUST use https://bracha.labkit.dev — wrong host breaks sitemap/canonical.
# Locally you can override to http://localhost:4321
PUBLIC_SITE_URL="https://bracha.labkit.dev"

# Cloudflare Turnstile (bot protection on the greeting form).
# The values below are Cloudflare's public TEST keys – they always pass and are
# fine for local dev. Replace with real keys from
# https://dash.cloudflare.com/?to=/:account/turnstile before deploying.
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Google AdSense. Leave PUBLIC_ADSENSE_CLIENT empty to disable ads entirely
# (no script, no <ins>, ads.txt returns a placeholder).
# Publisher id from https://www.google.com/adsense , format "ca-pub-0000000000000000".
PUBLIC_ADSENSE_CLIENT=""
# Ad-unit ids (the numeric "data-ad-slot") created under AdSense → Ads → By ad unit.
# Optional – leave empty to rely on AdSense Auto Ads instead of fixed placements.
PUBLIC_ADSENSE_SLOT_CONTENT=""
PUBLIC_ADSENSE_SLOT_GREETING=""
# Set to "1" to render visible dashed placeholders in place of every ad unit,
# so placements can be checked before AdSense approval / while ads are unfilled.
PUBLIC_ADSENSE_DEBUG=""
