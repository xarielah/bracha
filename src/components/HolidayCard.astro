---
import type { Holiday } from '../data/holidays';
import Motif from './Motif.astro';

export interface Props {
  holiday: Holiday;
}
const { holiday } = Astro.props;
const p = holiday.palette;
const styleVars = [
  `--bg:${p.bg}`,
  `--ink:${p.ink}`,
  `--accent:${p.accent}`,
  `--accent2:${p.accent2}`,
  `--surface:${p.surface}`,
].join(';');
---

<a class="holiday-card" href={`/${holiday.slug}`} style={styleVars} aria-label={`ברכות ל${holiday.name}`}>
  <Motif slug={holiday.slug} class="hc-motif" />
  <div class="hc-text">
    <h2 class="hc-name">{holiday.name}</h2>
    <p class="hc-tagline">{holiday.tagline}</p>
  </div>
  <span class="hc-go">צרו ברכה ←</span>
</a>

<style>
  .holiday-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    min-height: 230px;
    padding: 1.4rem;
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .holiday-card:hover,
  .holiday-card:focus-visible {
    transform: translateY(-4px) scale(1.01);
    box-shadow: 0 26px 70px -18px rgba(0, 0, 0, 0.55);
  }

  .hc-motif {
    width: 74px;
    height: 74px;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.3));
  }

  .hc-text {
    margin-top: auto;
  }

  .hc-name {
    margin: 0;
    font-size: 1.6rem;
  }

  .hc-tagline {
    margin: 0.2rem 0 0;
    opacity: 0.9;
    font-size: 0.95rem;
  }

  .hc-go {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--accent);
  }
</style>
