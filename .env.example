# MongoDB connection string (MongoDB Atlas or self-hosted)
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority"

# Optional: database name (defaults to "bracha")
MONGODB_DB="bracha"

# Public site URL used for canonical tags, OG and share links
PUBLIC_SITE_URL="http://localhost:4321"

# Cloudflare Turnstile (bot protection on the greeting form).
# The values below are Cloudflare's public TEST keys – they always pass and are
# fine for local dev. Replace with real keys from
# https://dash.cloudflare.com/?to=/:account/turnstile before deploying.
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
