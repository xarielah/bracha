---
import { ADSENSE_CLIENT, adsenseEnabled, ADSENSE_DEBUG } from '../lib/ads';

export interface Props {
  /** AdSense ad-unit id (data-ad-slot). Required in production. */
  slot?: string;
  /** data-ad-format */
  format?: string;
  /** data-ad-layout (for in-article / in-feed units) */
  layout?: string;
  class?: string;
  label?: string;
}

const {
  slot = '',
  format = 'auto',
  layout,
  class: className,
  label = 'פרסומת',
} = Astro.props;

// Production: render only with a real client + slot.
// Debug: always render a placeholder so placements are visible pre-approval.
const showReal = adsenseEnabled && Boolean(slot) && !ADSENSE_DEBUG;
const showDebug = ADSENSE_DEBUG;
---

{
  showReal && (
    <aside class:list={['ad', className]} aria-label="פרסומת">
      <span class="ad-label">{label}</span>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot={slot}
        data-ad-format={format}
        data-ad-layout={layout}
        data-full-width-responsive="true"
      />
      <script is:inline>
        (function () {
          var s = document.currentScript;
          var ins = s && s.previousElementSibling;
          if (!ins) return;
          var pushed = false;
          function fill() {
            if (pushed) return;
            if (!ins.clientWidth) return;
            pushed = true;
            try {
              (adsbygoogle = window.adsbygoogle || []).push({});
            } catch (e) {}
          }
          if ('IntersectionObserver' in window) {
            var io = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (entry.isIntersecting) {
                    fill();
                    if (pushed) io.disconnect();
                  }
                });
              },
              { rootMargin: '250px' }
            );
            io.observe(ins);
          } else {
            fill();
          }
        })();
      </script>
    </aside>
  )
}

{
  showDebug && (
    <aside class:list={['ad', 'ad--debug', className]} aria-label="פרסומת (מצב בדיקה)">
      <span class="ad-label">{label} · מצב בדיקה</span>
      <div class="ad-placeholder">
        {adsenseEnabled ? ADSENSE_CLIENT : 'client לא מוגדר'}
        <br />
        slot: {slot || 'ריק → Auto Ads בלבד'}
      </div>
    </aside>
  )
}

<style>
  .ad {
    display: block;
    width: 100%;
    margin-block: clamp(1.5rem, 5vw, 3rem);
    text-align: center;
  }

  .ad:not(.ad--debug):has(.adsbygoogle[data-ad-status='unfilled']) {
    display: none;
  }

  .ad-label {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }

  .adsbygoogle {
    display: block;
    border-radius: 12px;
    overflow: hidden;
  }

  .ad-placeholder {
    display: grid;
    place-content: center;
    min-height: 120px;
    padding: 1rem;
    border: 2px dashed var(--border);
    border-radius: 12px;
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.7;
    word-break: break-all;
  }
</style>
