---
import type { Holiday } from '../data/holidays';
import Motif from './Motif.astro';

export interface Props {
  holiday: Holiday;
}
const { holiday } = Astro.props;
const p = holiday.palette;
const styleVars = [
  `--bg:${p.bg}`,
  `--ink:${p.ink}`,
  `--accent:${p.accent}`,
  `--accent2:${p.accent2}`,
  `--surface:${p.surface}`,
].join(';');
---

<a
  class="holiday-card"
  href={`/${holiday.slug}`}
  style={styleVars}
  aria-label={`ברכות ל${holiday.name}`}
>
  <div class="hc-shine" aria-hidden="true"></div>
  <span class="hc-emblem">
    <Motif slug={holiday.slug} class="hc-motif" />
  </span>
  <div class="hc-text">
    <h2 class="hc-name">{holiday.name}</h2>
    <p class="hc-tagline">{holiday.tagline}</p>
  </div>
  <span class="hc-go">צרו ברכה ←</span>
</a>

<style>
  .holiday-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.85rem;
    min-height: 244px;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--bg);
    background-color: var(--accent2);
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    box-shadow: var(--shadow);
    isolation: isolate;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .hc-shine {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(110% 55% at 50% -25%, rgba(255, 255, 255, 0.25), transparent 60%),
      radial-gradient(70% 50% at 110% 120%, rgba(0, 0, 0, 0.24), transparent 60%);
  }

  .holiday-card > :not(.hc-shine) {
    position: relative;
    z-index: 1;
  }

  .holiday-card:hover,
  .holiday-card:focus-visible {
    transform: translateY(-4px) scale(1.01);
    box-shadow: 0 26px 70px -18px rgba(0, 0, 0, 0.55);
  }

  .hc-emblem {
    width: 82px;
    height: 82px;
    display: grid;
    place-items: center;
  }
  .hc-motif {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.32));
    transition: transform 0.25s ease;
  }
  .holiday-card:hover .hc-motif {
    transform: rotate(-4deg) scale(1.06);
  }

  .hc-text {
    margin-top: auto;
  }

  .hc-name {
    margin: 0;
    font-size: 1.65rem;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.22);
  }

  .hc-tagline {
    margin: 0.2rem 0 0;
    opacity: 0.92;
    font-size: 0.95rem;
  }

  .hc-go {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--ink);
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    .holiday-card,
    .hc-motif {
      transition: none;
    }
  }
</style>
