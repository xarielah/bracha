---
import '@fontsource-variable/heebo';
import '@fontsource-variable/rubik';
import { ADSENSE_CLIENT, adsenseEnabled } from '../lib/ads';

export interface Props {
  title: string;
  description: string;
  /** path only, e.g. "/hanukkah" */
  path?: string;
  image?: string;
  noindex?: boolean;
  keywords?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** set false to skip loading the AdSense script on this page (e.g. 404) */
  ads?: boolean;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image = '/og-default.svg',
  noindex = false,
  keywords = [],
  jsonLd,
  ads = true,
} = Astro.props;

const loadAds = adsenseEnabled && ads;
const year = new Date().getFullYear();

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(path, site).href;
const ogImage = new URL(image, site).href;
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f6f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1020" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      adsenseEnabled && (
        <meta name="google-adsense-account" content={ADSENSE_CLIENT} />
      )
    }
    {
      loadAds && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
          crossorigin="anonymous"
        />
      )
    }
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          document.documentElement.dataset.theme =
            t === 'dark' || t === 'light' ? t : 'light';
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ברכות לחגי ישראל" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="generator" content={Astro.generator} />
    {
      jsonLdArray.map((obj) => (
        <script type="application/ld+json" set:html={JSON.stringify(obj)} />
      ))
    }
  </head>
  <body>
    <button
      id="theme-toggle"
      type="button"
      class="theme-toggle"
      aria-label="החלפת מצב תצוגה (בהיר/כהה)"
      aria-pressed="false"
    >
      <span aria-hidden="true">🌙</span>
    </button>
    <slot />
    <footer class="site-footer">
      <div class="container">
        <nav class="site-footer__links" aria-label="ניווט תחתון">
          <a href="/">כל החגים</a>
          <a href="/privacy">מדיניות פרטיות</a>
        </nav>
        <p>© {year} ברכות לחגי ישראל · נבנה באהבה לכל חג ומועד</p>
      </div>
    </footer>
  </body>
</html>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;

  function currentTheme(): 'light' | 'dark' {
    return root.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function render(theme: 'light' | 'dark') {
    const icon = btn?.querySelector('span');
    if (icon) icon.textContent = theme === 'dark' ? '☀️' : '🌙';
    btn?.setAttribute('aria-pressed', String(theme === 'dark'));
  }

  function apply(theme: 'light' | 'dark') {
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {
      /* storage blocked */
    }
    render(theme);
  }

  render(currentTheme());
  btn?.addEventListener('click', () => {
    apply(currentTheme() === 'dark' ? 'light' : 'dark');
  });
</script>

<style is:global>
  :root {
    --font-body: 'Heebo Variable', 'Heebo', system-ui, -apple-system, 'Segoe UI', Arial, sans-serif;
    --font-display: 'Rubik Variable', 'Rubik', 'Heebo Variable', system-ui, sans-serif;
    --maxw: 1120px;
    --radius: 18px;

    /* ---- Light theme (default) ---- */
    color-scheme: light;
    --page-bg: #f7f6f3;
    --page-ink: #1e1b26;
    --text-muted: #5b5766;
    --surface-1: #ffffff;
    --surface-2: #efedf3;
    --border: rgba(30, 27, 38, 0.12);
    --hover: rgba(30, 27, 38, 0.06);
    --brand: #6d28d9;
    --brand-contrast: #ffffff;
    --danger: #c81d63;
    --shadow: 0 20px 50px -24px rgba(30, 27, 38, 0.28);
    --hero-glow-1: rgba(109, 40, 217, 0.14);
    --hero-glow-2: rgba(242, 193, 78, 0.2);

    /* per-holiday tokens (components override these inline) */
    --bg: linear-gradient(160deg, #23243a, #3a3c5c);
    --ink: #f5f5fa;
    --accent: #f2c14e;
    --accent2: #7b1e3b;
    --surface: #fffaf0;
    --surface-ink: #2a2a3a;
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
    --page-bg: #0f1020;
    --page-ink: #f3f2f7;
    --text-muted: #a8a4b8;
    --surface-1: rgba(255, 255, 255, 0.06);
    --surface-2: rgba(0, 0, 0, 0.28);
    --border: rgba(255, 255, 255, 0.14);
    --hover: rgba(255, 255, 255, 0.1);
    --brand: #b79bff;
    --brand-contrast: #17131f;
    --danger: #ff9db1;
    --shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.55);
    --hero-glow-1: rgba(123, 47, 247, 0.22);
    --hero-glow-2: rgba(242, 193, 78, 0.16);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: var(--font-body);
    color: var(--page-ink);
    background: var(--page-bg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .theme-toggle {
    position: fixed;
    inset-block-end: 1rem;
    inset-inline-start: 1rem;
    z-index: 50;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    font-size: 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-1);
    color: var(--page-ink);
    box-shadow: var(--shadow);
    transition: transform 0.15s ease;
  }

  .theme-toggle:hover {
    transform: scale(1.08);
  }

  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 3rem;
    padding: 2rem 0 2.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .site-footer p {
    margin: 0.6rem 0 0;
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  .site-footer__links a {
    color: var(--brand);
    text-decoration: none;
  }
  .site-footer__links a:hover {
    text-decoration: underline;
  }

  a {
    color: inherit;
  }

  img,
  svg {
    max-width: 100%;
  }

  button {
    font: inherit;
    cursor: pointer;
  }

  .container {
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
