---
import '@fontsource-variable/heebo';
import '@fontsource/frank-ruhl-libre/500.css';
import '@fontsource/frank-ruhl-libre/700.css';

export interface Props {
  title: string;
  description: string;
  /** path only, e.g. "/hanukkah" */
  path?: string;
  image?: string;
  noindex?: boolean;
  keywords?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image = '/og-default.svg',
  noindex = false,
  keywords = [],
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(path, site).href;
const ogImage = new URL(image, site).href;
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ברכות לחגי ישראל" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="generator" content={Astro.generator} />
    {
      jsonLdArray.map((obj) => (
        <script type="application/ld+json" set:html={JSON.stringify(obj)} />
      ))
    }
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --font-body: 'Heebo Variable', 'Heebo', system-ui, -apple-system, 'Segoe UI', Arial, sans-serif;
    --font-display: 'Frank Ruhl Libre', 'Heebo Variable', Georgia, serif;
    --page-bg: #0f1226;
    --page-ink: #f5f5fa;
    --maxw: 1120px;
    --radius: 18px;
    --shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.45);

    /* per-holiday tokens, overridden via [data-holiday] */
    --bg: linear-gradient(160deg, #23243a, #3a3c5c);
    --ink: #f5f5fa;
    --accent: #f2c14e;
    --accent2: #7b1e3b;
    --surface: #fffaf0;
    --surface-ink: #2a2a3a;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: var(--font-body);
    color: var(--page-ink);
    background: var(--page-bg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    line-height: 1.2;
    font-weight: 700;
  }

  a {
    color: inherit;
  }

  img,
  svg {
    max-width: 100%;
  }

  button {
    font: inherit;
    cursor: pointer;
  }

  .container {
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
